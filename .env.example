# Copy to .env and fill in the values below. Keep .env out of Git.
LAYA_ADMIN_USERNAME=admin
# Set a password of at least 10 characters, or use LAYA_ADMIN_PASSWORD_HASH instead.
LAYA_ADMIN_PASSWORD=''
# LAYA_ADMIN_PASSWORD_HASH='$argon2id$...'
LAYA_SESSION_HOURS=12
LAYA_MAX_LOADED_MODELS=1
# NVIDIA CUDA is required by default. Use cuda:1 to select another visible GPU.
LAYA_DEVICE=cuda
# For explicit CPU inference, set LAYA_DEVICE=cpu and remove the GPU reservation in compose.yaml.
